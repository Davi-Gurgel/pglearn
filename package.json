{
  "name": "pglearn",
  "version": "0.1.0",
  "private": true,
  "description": "A visual PostgreSQL client that explains what the database is doing",
  "homepage": "https://github.com/Davi-Gurgel/pglearn",
  "license": "MIT",
  "author": "Davi Gurgel",
  "repository": {
    "type": "git",
    "url": "https://github.com/Davi-Gurgel/pglearn.git"
  },
  "main": "./out/main/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "oxlint --disable-nested-config --deny-warnings",
    "format": "oxfmt",
    "sync:repos": ".repos/sync.sh",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "screenshots": "pnpm build && node --experimental-strip-types scripts/screenshots.ts",
    "dist:mac": "pnpm build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.1",
    "effect": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
